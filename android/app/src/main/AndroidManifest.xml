<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.applocker.app_locker">

    <!-- Berechtigungen für biometrische Authentifizierung -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Berechtigung zum Abrufen installierter Apps -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Berechtigung für Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Berechtigung für Package Usage Stats (zum Überwachen von App-Starts) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        android:protectionLevel="signature|privileged|development" />

    <!-- Berechtigung für System Alert Window (zum Anzeigen des Lock-Screens über anderen Apps) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Internet-Berechtigung (optional, falls benötigt) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="${applicationName}"
        android:label="AppLocker"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Splash Screen Theme während des Ladens -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- Intent Filter für App-Start -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground Service für App-Überwachung -->
        <service
            android:name=".AppMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Flutter-spezifische Metadaten -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Hardware-Anforderungen (optional, aber empfohlen) -->
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.biometrics"
        android:required="false" />
</manifest>
